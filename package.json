{
  "name": "lava",
  "version": "0.1.0",
  "description": "Lava — an ultra-lightweight, zero-dependency WhatsApp library. Native mobile (WAP) primary + companion modes, Signal E2E, app-state sync, calls.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist dist-test",
    "prepare": "npm run build",
    "pretest": "npm run build:test",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "node --test \"dist-test/test/**/*.test.js\"",
    "prebench": "npm run build:test",
    "bench": "node dist-test/bench/memory.js",
    "size": "npm run build && node scripts/size.js"
  },
  "keywords": [
    "lava",
    "whatsapp",
    "wa",
    "signal",
    "wap",
    "mobile",
    "lightweight",
    "zero-dependency"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkyck/lava.git"
  },
  "homepage": "https://github.com/kkyck/lava#readme",
  "bugs": {
    "url": "https://github.com/kkyck/lava/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
